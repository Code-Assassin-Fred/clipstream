PORT=3000
NODE_ENV=development

# local | azure
STORAGE_MODE=local

# local mode
LOCAL_DATA_DIR=./data

# azure mode (Part B)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=videos
MEDIA_BASE_URL=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=clipstream
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# auth: dev | easyauth | entra
AUTH_MODE=dev

# Microsoft Entra ID (when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# limits
MAX_UPLOAD_MB=100
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# demo helpers
ENABLE_DEBUG_ENDPOINTS=false

